package component:aws-cli;

interface providers {

    record credentials {
        access-key-id: string,
        secret-access-key: string,
        session-token: option<string>,

        /// Credential Expiry (Seconds)
        expires-after: option<u64>,

        /// AWS Account Identifier
        account-id: option<string>,
    }

    record timeout {
        duration: u64
    }

    variant credentials-error {
        credentials-not-loaded,
        provider-timed-out(timeout),
        invalid-configuration,
        provider-error,
        unhandled,
    }

    provide-credentials: func(service-id: option<string>) -> result<credentials, credentials-error>;

    type region = string;
    provide-region: func(region: option<region>) -> option<region>;
}

world cli {
    include wasi:cli/command@0.2.12;

    import providers;
    import wasi:http/outgoing-handler@0.2.12;
}
