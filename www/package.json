{
  "name": "wasm-web-shell",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "build": "webpack --mode production --no-devtool && rm -rf ./dist/*.LICENSE.*",
    "dev": "webpack --mode development",
    "start": "ASSET_PATH='/' webpack serve",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@xterm/xterm": "^6.0.0",
    "aws-cli-wasm": "file://./aws-cli",
    "cookie-store": "^4.0.0-next.4",
    "native-file-system-adapter": "github:jimmywarting/native-file-system-adapter",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "wasm-terminal": "file://./wasm-terminal"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "html-webpack-plugin": "^5.6.7",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.0",
    "typescript": "^6.0.3",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "webpack-dev-server": "^5.2.4"
  }
}
